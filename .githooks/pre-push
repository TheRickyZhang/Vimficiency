#!/usr/bin/env bash
# pre-push: queue a local benchmark run for each pushed branch.
#
# Receives "<local-ref> <local-sha> <remote-ref> <remote-sha>" lines on stdin
# (see githooks(5)). For each ref being pushed to origin we background a
# bench-local-run.sh invocation and let the push proceed immediately. Failures
# in the hook never block the push — the bench is observational, not gating.
#
# Install with `scripts/install-hooks.sh`.
set -u

REMOTE="${1:-}"
if [ "$REMOTE" != "origin" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
RUNNER="$REPO_ROOT/scripts/bench-local-run.sh"
if [ ! -x "$RUNNER" ]; then
  echo "[pre-push] $RUNNER missing or not executable; skipping bench" >&2
  exit 0
fi

# Surface the ccache requirement here too — otherwise a missing-ccache
# failure happens in the background and only shows up in the log file.
if ! command -v ccache >/dev/null 2>&1; then
  echo "[pre-push] ccache not installed; skipping bench (install with 'sudo pacman -S ccache')" >&2
  exit 0
fi

# Surface any failure from the previous run. The runner is backgrounded
# with output redirected, so an exit-128 crash like "unable to read tree"
# is otherwise invisible until the user proactively checks the log dir.
# A successful run overwrites $STATUS with exit_code=0, so this warning
# clears itself naturally.
STATUS="${VIMFICIENCY_BENCH_CACHE:-$HOME/.cache/vimficiency-bench}/last-status"
if [ -f "$STATUS" ]; then
  # shellcheck disable=SC1090
  . "$STATUS"
  if [ "${exit_code:-0}" != "0" ]; then
    echo "[pre-push] previous bench run FAILED (exit ${exit_code}, sha ${sha:0:8} on ${branch})" >&2
    echo "[pre-push]   log: ${log}" >&2
  fi
  unset exit_code sha branch log ended_at
fi

ZERO=0000000000000000000000000000000000000000

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  # Branch deletion — nothing to benchmark.
  if [ "$LOCAL_SHA" = "$ZERO" ]; then
    continue
  fi
  # Tags, notes, etc. — skip.
  case "$REMOTE_REF" in
    refs/heads/*) ;;
    *) continue ;;
  esac
  BRANCH="${REMOTE_REF#refs/heads/}"

  # main is benched by .github/workflows/bench-main.yml on the self-hosted
  # macOS runner — running a second bench locally would race with that
  # workflow over the gh-pages push and produce duplicate (possibly
  # divergent-hardware) chart entries. Feature branches still bench locally.
  if [ "$BRANCH" = "main" ]; then
    echo "[pre-push] main is benched by the self-hosted runner; skipping local bench for $BRANCH" >&2
    continue
  fi

  # Guardrails. Each prints a reason and skips this ref — never blocks the push.
  if [ -n "$(git status --porcelain)" ]; then
    echo "[pre-push] working tree dirty; skipping bench for $BRANCH" >&2
    continue
  fi
  if [ "$(git rev-parse HEAD)" != "$LOCAL_SHA" ]; then
    # Multiple refs being pushed, or pushing a branch that isn't checked out.
    # The runner clones to its own cache so HEAD doesn't strictly need to
    # match — but we use this check as a sanity proxy for "the user pushed
    # what they're currently looking at." For a multi-ref push only the ref
    # equal to HEAD gets benched.
    echo "[pre-push] HEAD != $LOCAL_SHA for $BRANCH; skipping" >&2
    continue
  fi
  if [ -r /sys/class/power_supply/AC/online ] && [ "$(cat /sys/class/power_supply/AC/online)" = "0" ]; then
    echo "[pre-push] on battery; skipping bench for $BRANCH" >&2
    continue
  fi

  # Detach fully: setsid puts the runner in its own session so closing the
  # terminal that ran `git push` doesn't SIGHUP a 10-minute build mid-run.
  if command -v setsid >/dev/null 2>&1; then
    setsid nohup "$RUNNER" "$LOCAL_SHA" "$BRANCH" </dev/null >/dev/null 2>&1 &
  else
    nohup "$RUNNER" "$LOCAL_SHA" "$BRANCH" </dev/null >/dev/null 2>&1 &
  fi
  disown 2>/dev/null || true
  echo "[pre-push] queued bench for $BRANCH @ ${LOCAL_SHA:0:8} (log: ~/.cache/vimficiency-bench/logs/)" >&2
done

exit 0
