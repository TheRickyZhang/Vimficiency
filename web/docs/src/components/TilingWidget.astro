---
// Cheapest counted-command tiling of a span the reader selects by dragging.
interface Props { text?: string; begin?: number; end?: number }
const { text = 'one two three four\nfive six', begin = 0, end = 13 } = Astro.props;
---
<vf-tiling-widget class="vf-widget" data-begin={begin} data-end={end}>
  <label>Text<textarea data-text>{text}</textarea></label>
  <div class="vf-controls">
    <span>Price as:</span>
    <button type="button" data-kind="delete" aria-pressed="true">delete</button>
    <button type="button" data-kind="move" aria-pressed="false">move</button>
    <span class="vf-rowlabel" style="margin:0">drag across the characters to pick a span</span>
  </div>
  <div data-chars></div>
  <div data-chunks></div>
  <div class="vf-total" data-total></div>
  <div class="vf-status" data-status>Loading planner…</div>
</vf-tiling-widget>

<script>
  import { tiling, debounce, fmt, charCells, readText, reportError, type TilingResult } from '../scripts/planner';

  class TilingWidget extends HTMLElement {
    private kind: 'delete' | 'move' = 'delete';
    private begin = 0;
    private end = 0;
    private text = '';
    private dragFrom = -1;

    private q<T extends HTMLElement>(sel: string) { return this.querySelector(sel) as T; }

    connectedCallback() {
      this.begin = Number(this.dataset.begin ?? 0);
      this.end = Number(this.dataset.end ?? 0);
      const run = debounce(() => this.run(), 150);
      this.q('[data-text]').addEventListener('input', () => {
        this.text = readText(this, '[data-text]');
        this.begin = Math.min(this.begin, Math.max(0, this.text.length - 1));
        this.end = Math.min(Math.max(this.end, this.begin + 1), this.text.length);
        this.drawChars();
        run();
      });
      this.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((b) =>
        b.addEventListener('click', () => {
          this.kind = b.dataset.kind as 'delete' | 'move';
          this.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach((o) =>
            o.setAttribute('aria-pressed', String(o === b)));
          this.run();
        }));
      // Capture on the container: drawChars replaces the row, and a captured
      // element that leaves the DOM loses the capture.
      const chars = this.q('[data-chars]');
      chars.addEventListener('pointerdown', (ev) => {
        const i = this.indexAt(ev);
        if (i < 0) return;
        this.dragFrom = i;
        this.begin = i;
        this.end = i + 1;
        chars.setPointerCapture(ev.pointerId);
        this.drawChars();
      });
      chars.addEventListener('pointermove', (ev) => {
        if (this.dragFrom < 0) return;
        const i = this.indexAt(ev);
        if (i < 0) return;
        this.begin = Math.min(this.dragFrom, i);
        this.end = Math.max(this.dragFrom, i) + 1;
        this.drawChars();
      });
      const endDrag = () => {
        if (this.dragFrom < 0) return;
        this.dragFrom = -1;
        this.run();
      };
      chars.addEventListener('pointerup', endDrag);
      chars.addEventListener('pointercancel', endDrag);
      this.text = readText(this, '[data-text]');
      this.end = Math.min(this.end, this.text.length);
      this.drawChars();
      this.run();
    }

    // Captured events target the container, so hit-test the point instead.
    private indexAt(ev: PointerEvent): number {
      const el = document.elementFromPoint(ev.clientX, ev.clientY)?.closest<HTMLElement>('.vf-ch');
      return el && this.contains(el) ? Number(el.dataset.index) : -1;
    }

    private drawChars() {
      const row = charCells(this.text, (i) => (i >= this.begin && i < this.end ? 'vf-sel' : undefined));
      this.q('[data-chars]').replaceChildren(row);
    }

    private async run() {
      const status = this.q('[data-status]');
      if (this.end <= this.begin) {
        status.textContent = 'Select at least one character.';
        return;
      }
      try {
        const r = await tiling(this.text, this.begin, this.end, this.kind);
        this.renderChunks(r);
        status.classList.remove('vf-error');
        status.textContent = `[${this.begin}, ${this.end}) ${this.kind}: ${fmt(r.cost)} with these chunks, `
          + `${fmt(r.charOnly)} as a chain of ${this.kind === 'delete' ? 'x' : 'l'} alone.`;
      } catch (e) {
        reportError(status, e);
      }
    }

    private renderChunks(r: TilingResult) {
      const row = document.createElement('div');
      row.className = 'vf-chunks';
      const cellW = this.q('[data-chars] .vf-ch')?.getBoundingClientRect().width ?? 12;
      const pad = document.createElement('span');
      pad.className = 'vf-pad';
      pad.style.width = `${this.begin * cellW}px`;
      row.appendChild(pad);
      for (const c of r.chunks) {
        const el = document.createElement('span');
        el.className = `vf-chunk${this.kind === 'move' ? ' vf-chunk-move' : ''}`;
        el.style.width = `${(c.end - c.begin) * cellW}px`;
        el.textContent = `${c.label} ${fmt(c.cost)}`;
        el.title = `[${c.begin}, ${c.end}) ${c.label}: ${fmt(c.cost)}`;
        row.appendChild(el);
      }
      this.q('[data-chunks]').replaceChildren(row);
      this.q('[data-total]').textContent = r.chunks.map((c) => c.label).join(' · ') + ` = ${fmt(r.cost)}`;
    }
  }

  if (!customElements.get('vf-tiling-widget')) customElements.define('vf-tiling-widget', TilingWidget);
</script>
