#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$here/.." && pwd)"

build_dir="${VIMFY_BUILD_DIR:-build}"
case "$build_dir" in
  /*) ;;
  *) build_dir="$repo_root/$build_dir" ;;
esac

# Optional `--for <dur>` / `--for=<dur>` knob: sets FUZZTEST_FUZZ_FOR for the
# generated suites. Extracted from anywhere in the args so the positional
# parsing below is unaffected. With the watchdog patch
# (tests/patches/fuzztest-watchdog.patch) this shortens runs for real.
fuzz_for=""
_args=()
while (( $# )); do
  case "$1" in
    --for) fuzz_for="${2:-}"; shift; (( $# )) && shift ;;
    --for=*) fuzz_for="${1#--for=}"; shift ;;
    *) _args+=("$1"); shift ;;
  esac
done
if (( ${#_args[@]} )); then set -- "${_args[@]}"; else set --; fi

suite="${1:-all}"
filter="${2:-}"
mode="${3:-explore}"
approval_update=0
fuzztest_seed="OffQXb8u5_vZtH4-7wgVOLu_HNAhPIbLz7CFF13u3nk"
repeat=1

# `vimfy_tests property 10` etc. — a bare positive integer in the filter slot
# means "run the suite that many times" rather than a gtest filter.
if [[ "$suite" == "all" || "$suite" == "property" || "$suite" == "safety" ]]; then
  if [[ "$filter" =~ ^[1-9][0-9]*$ ]]; then
    repeat="$filter"
    filter=""
  elif [[ "${3:-}" =~ ^[1-9][0-9]*$ ]]; then
    repeat="$3"
  fi
fi

if [[ "$suite" == "approval" ]]; then
  case "$filter" in
    --approve|--update|--override)
      approval_update=1
      filter="${3:-}"
      ;;
  esac
  case "${3:-}" in
    --approve|--update|--override)
      approval_update=1
      ;;
  esac
fi

if [[ "$suite" == "all" || "$suite" == "property" || "$suite" == "safety" ]]; then
  if [[ $# -lt 3 ]]; then
    case "$filter" in
      seed|explore|campaign)
        mode="$filter"
        filter=""
        ;;
    esac
  fi
fi

require_executable() {
  local path="$1"
  local target="$2"
  if [[ -x "$path" ]]; then
    return
  fi

  echo "error: $path not found" >&2
  echo "  Run: cmake -B build && cmake --build build --target $target" >&2
  exit 1
}

run_gtest() {
  local binary="$1"
  local test_filter="${2:-}"

  local args=(--gtest_brief=1)
  if [[ -n "$test_filter" ]]; then
    args+=(--gtest_filter="$test_filter")
  fi

  "$binary" "${args[@]}"
}

approve_received_files() {
  local fixtures_dir="$repo_root/tests/Approval/fixtures"
  local received_files=()
  local file

  shopt -s nullglob
  received_files=("$fixtures_dir"/*.received.txt)
  shopt -u nullglob

  if [[ ${#received_files[@]} -eq 0 ]]; then
    echo "error: no approval .received.txt files found" >&2
    return 1
  fi

  for file in "${received_files[@]}"; do
    local approved="${file/.received./.approved.}"
    cp "$file" "$approved"
    echo "approved ${approved#$repo_root/}"
  done
}

run_approval() {
  local binary="$1"
  local test_filter="${2:-}"
  local update="${3:-0}"

  if [[ "$update" != 1 ]]; then
    run_gtest "$binary" "$test_filter"
    return
  fi

  if run_gtest "$binary" "$test_filter"; then
    return
  fi

  approve_received_files
  run_gtest "$binary" "$test_filter"
}

filter_fuzztest_seed_line() {
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      FUZZTEST_PRNG_SEED=*) ;;
      *) printf '%s\n' "$line" ;;
    esac
  done
}

run_seed_generated() {
  local binary="$1"
  shift

  # FuzzTest always prints its seed at startup. Fixed-seed mode still explores,
  # but with a deterministic runner seed, so print the seed only on failure.
  if env FUZZTEST_PRNG_SEED="$fuzztest_seed" \
    "$binary" "$@" 2> >(filter_fuzztest_seed_line >&2); then
    return 0
  else
    local status=$?
    echo "FUZZTEST_PRNG_SEED=$fuzztest_seed" >&2
    return "$status"
  fi
}

run_one_generated() {
  local binary="$1"
  local test_filter="${2:-}"
  local run_mode="${3:-seed}"

  local args=(--gtest_brief=1)
  if [[ -n "$test_filter" ]]; then
    args+=(--gtest_filter="$test_filter")
  fi

  case "$run_mode" in
    seed)
      run_seed_generated "$binary" "${args[@]}"
      ;;
    explore)
      "$binary" "${args[@]}"
      ;;
    campaign)
      if [[ -z "$test_filter" ]]; then
        echo "error: campaign mode requires a test name/filter" >&2
        exit 1
      fi
      "$binary" --fuzz="$test_filter" --fuzz_for="${VIMFY_FUZZ_FOR:-30s}"
      ;;
    *)
      echo "error: unknown mode '$run_mode' (expected seed, explore, or campaign)" >&2
      exit 1
      ;;
  esac
}

run_generated() {
  local binary="$1"
  local test_filter="${2:-}"
  local run_mode="${3:-seed}"

  if [[ -n "$fuzz_for" ]]; then
    export FUZZTEST_FUZZ_FOR="$fuzz_for"
    echo "[fuzz_for=$fuzz_for] each FUZZ_TEST runs until $fuzz_for elapses or 10000 iterations"
  elif (( repeat > 1 )); then
    export FUZZTEST_FUZZ_FOR="${repeat}s"
    echo "[fuzz_for=${repeat}s] each FUZZ_TEST runs until ${repeat}s elapses or 10000 iterations"
  fi

  run_one_generated "$binary" "$test_filter" "$run_mode"
}

run_lua() {
  local file="${1:-}"
  local lib="$build_dir/libvimficiency.so"
  if [[ ! -f "$lib" ]]; then
    echo "error: $lib not found" >&2
    echo "  Run: cmake -B build && cmake --build build --target vimficiency" >&2
    exit 1
  fi

  if [[ -n "$file" ]]; then
    VIMFICIENCY_LIB_PATH="$lib" VF_TEST_FILE="$file" \
      nvim --headless -u NONE -U NONE -l "$repo_root/tests/lua/runner.lua"
  else
    VIMFICIENCY_LIB_PATH="$lib" bash "$repo_root/tests/lua/run.sh"
  fi
}

unit_binary="$build_dir/tests/vimfy_unit_tests"
approval_binary="$build_dir/tests/vimfy_approval_tests"
property_binary="$build_dir/tests/vimfy_property_tests"
safety_binary="$build_dir/tests/vimfy_safety_tests"

case "$suite" in
  all)
    require_executable "$unit_binary" vimfy_unit_tests
    require_executable "$approval_binary" vimfy_approval_tests
    require_executable "$property_binary" vimfy_property_tests
    require_executable "$safety_binary" vimfy_safety_tests
    run_gtest "$unit_binary"
    run_gtest "$approval_binary"
    run_generated "$property_binary" "" "$mode"
    run_generated "$safety_binary" "" "$mode"
    run_lua
    ;;
  unit)
    require_executable "$unit_binary" vimfy_unit_tests
    run_gtest "$unit_binary" "$filter"
    ;;
  approval)
    require_executable "$approval_binary" vimfy_approval_tests
    run_approval "$approval_binary" "$filter" "$approval_update"
    ;;
  property)
    require_executable "$property_binary" vimfy_property_tests
    run_generated "$property_binary" "$filter" "$mode"
    ;;
  safety)
    require_executable "$safety_binary" vimfy_safety_tests
    run_generated "$safety_binary" "$filter" "$mode"
    ;;
  lua)
    run_lua "$filter"
    ;;
  *)
    echo "usage: scripts/vimfy_tests [all|unit|approval|property|safety|lua] [filter-or-file|N] [seed|explore|campaign|N|--approve]" >&2
    echo "  property/safety/all default to explore mode; CI passes seed for deterministic generated tests." >&2
    echo "  property/safety/all accept a positive integer N to budget each FUZZ_TEST for N seconds (FUZZTEST_FUZZ_FOR)." >&2
    echo "  property/safety/all accept --for <dur> (e.g. 0.2s, 500ms, 2s) to set each FUZZ_TEST's budget directly." >&2
    echo "  approval accepts --approve before or after the optional filter to update snapshots and rerun." >&2
    exit 1
    ;;
esac
