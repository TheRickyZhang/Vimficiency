// Canonical C ABI for LuaJIT FFI.
// Included by Api.h for C++ compile-time checks and read directly by
// lua/vimficiency/ffi.lua for ffi.cdef().

extern const int VF_KEY_COUNT;
extern const int VF_FINGER_COUNT;
extern const int VF_HAND_COUNT;
extern const int VF_COUNT_CLASS_COUNT;

typedef struct {
  double key_weight;
  double same_finger_weight;
  double same_key_weight;
  double alt_hand_weight;
  double good_roll_weight;
  double bad_roll_weight;
} VFScoreWeights;

typedef struct {
  int8_t hand;
  int8_t finger;
  double base_cost;
} VFKeyInfo;

typedef struct {
  bool has_base;
  double base;
  bool has_count_slope;
  double count_slope;
  bool has_span_slope;
  double span_slope;
} VFCountPenaltyOverride;

typedef struct {
  int default_keyboard;
  VFScoreWeights weights;
  VFKeyInfo keys[61];  // must match C++ KEY_COUNT
  int slice_buffer_amount;
  int32_t shiftwidth;
  bool use_count_penalty_overrides;
  VFCountPenaltyOverride count_penalty_overrides[14];  // must match C++ CountClassCOUNT
} VFConfig;

typedef struct {
  const char* data;
  size_t len;
} VFByteSlice;

VFConfig* vf_get_config();
void vf_apply_config();
void vf_reset_config();

const char* vf_key_name(int index);
const char* vf_finger_name(int index);
const char* vf_hand_name(int index);
const char* vf_count_class_name(int index);
VFByteSlice vf_analyze(
  const char* encoded_initial_lines,
  size_t encoded_initial_lines_len,
  const char* encoded_goal_lines,
  size_t encoded_goal_lines_len,
  int boundary_first_col,
  int boundary_last_col,
  bool has_lines_above,
  bool has_lines_below,
  int start_row,
  int start_col,
  int end_row,
  int end_col,
  const char* keyseq,
  size_t keyseq_len,
  int window_height,
  int scroll_amount,
  int results_calculated,
  const char* optimizer_overrides,
  size_t optimizer_overrides_len);
VFByteSlice vf_analyze_start_async(
  const char* encoded_initial_lines,
  size_t encoded_initial_lines_len,
  const char* encoded_goal_lines,
  size_t encoded_goal_lines_len,
  int boundary_first_col,
  int boundary_last_col,
  bool has_lines_above,
  bool has_lines_below,
  int start_row,
  int start_col,
  int end_row,
  int end_col,
  const char* keyseq,
  size_t keyseq_len,
  int window_height,
  int scroll_amount,
  int results_calculated,
  const char* optimizer_overrides,
  size_t optimizer_overrides_len,
  int deadline_ms);
VFByteSlice vf_analyze_poll(int job_id);
int vf_analyze_cancel(int job_id);
VFByteSlice vf_compute_diffs(
  const char* encoded_initial_lines,
  size_t encoded_initial_lines_len,
  const char* encoded_goal_lines,
  size_t encoded_goal_lines_len,
  int diff_algorithm);
VFByteSlice vf_get_debug();
VFByteSlice vf_get_warnings();
VFByteSlice vf_get_optimizer_defaults();
int vf_version();
const char* vf_abi_hash();
VFByteSlice vf_debug_config();

VFByteSlice vf_tokenize_movements(const char* seq, size_t seq_len);
VFByteSlice vf_tokenize_sequence(const char* seq, size_t seq_len);
